---
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import type { Project } from '../data/projects';
import { url } from '../lib/url';
interface Props { p: Project; compact?: boolean }
const { p, compact = false } = Astro.props;
const iconFor: Record<string, string> = { Code: 'code', Live: 'live', Video: 'video', Post: 'post', PR: 'pr', Docs: 'docs' };
const main = p.links[0]?.url;
---
<article class="card card-hover group flex h-full flex-col overflow-hidden p-0">
  <a href={main} target="_blank" rel="noopener" class="block p-3 pb-0" tabindex="-1" aria-hidden="true">
    <div class="aspect-[16/9] overflow-hidden rounded-sm border border-line bg-paper dark:border-night-line dark:bg-night">
      <img src={url(`assets/covers/${p.slug}.jpg`)} alt="" loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
    </div>
  </a>
  <div class="flex flex-1 flex-col p-5 pt-4">
    <div class="mb-1.5 flex items-start justify-between gap-3">
      <h3 class="font-serif text-[1.3rem] font-semibold leading-snug text-ink dark:text-stone-50">{p.name}</h3>
      {p.badge && <span class="mt-1 shrink-0 rounded-full bg-brand/10 px-2.5 py-0.5 text-[11.5px] font-semibold text-brand ring-1 ring-brand/20 dark:bg-brand-soft/10 dark:text-brand-soft dark:ring-brand-soft/25">{p.badge}</span>}
    </div>
    <p class="muted text-[15px] leading-relaxed">{p.summary}</p>
    {!compact && p.did.length > 0 && (
      <ul class="mt-3 space-y-1.5 text-[14.5px] text-stone-700 dark:text-stone-300">
        {p.did.map((d) => <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand dark:bg-brand-soft"></span><span>{d}</span></li>)}
      </ul>
    )}
    <div class="mt-4 flex flex-wrap gap-1.5">{p.stack.map((s) => <span class="pill"><BrandIcon name={s} />{s}</span>)}</div>
    {p.links.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 border-t border-line pt-3 text-[14px] dark:border-night-line" style="margin-top:1.1rem">
        {p.links.map((l) => (
          <a href={l.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-medium text-muted hover:text-brand dark:text-night-muted dark:hover:text-brand-soft">
            <Icon name={iconFor[l.label]} class="h-3.5 w-3.5" />{l.label}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
