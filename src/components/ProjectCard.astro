---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
interface Props { p: Project; compact?: boolean }
const { p, compact = false } = Astro.props;
const iconFor: Record<string, string> = { Code: 'code', Live: 'live', Video: 'video', Post: 'post', PR: 'pr', Docs: 'docs' };
---
<article class="card card-hover flex h-full flex-col">
  <div class="mb-2 flex items-start justify-between gap-3">
    <h3 class="text-[17px] font-semibold leading-snug text-zinc-900 dark:text-zinc-50">{p.name}</h3>
    {p.badge && <span class="shrink-0 rounded-full bg-teal-50 px-2.5 py-0.5 text-[11.5px] font-semibold text-teal-800 ring-1 ring-teal-600/20 dark:bg-teal-400/10 dark:text-teal-300 dark:ring-teal-400/30">{p.badge}</span>}
  </div>
  <p class="text-[14.5px] leading-relaxed text-zinc-600 dark:text-zinc-400">{p.summary}</p>
  {!compact && p.did.length > 0 && (
    <ul class="mt-3 space-y-1.5 text-[14px] text-zinc-700 dark:text-zinc-300">
      {p.did.map((d) => <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500"></span><span>{d}</span></li>)}
    </ul>
  )}
  <div class="mt-4 flex flex-wrap gap-1.5">{p.stack.map((s) => <span class="pill">{s}</span>)}</div>
  {p.links.length > 0 && (
    <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 border-t border-zinc-100 pt-3 text-[13.5px] dark:border-zinc-800" style="margin-top:1rem">
      {p.links.map((l) => (
        <a href={l.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-medium text-zinc-600 hover:text-teal-600 dark:text-zinc-400 dark:hover:text-teal-300">
          <Icon name={iconFor[l.label]} class="h-3.5 w-3.5" />{l.label}
        </a>
      ))}
    </div>
  )}
</article>
