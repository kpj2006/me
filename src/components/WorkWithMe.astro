---
import { SITE } from '../data/site';
import { url } from '../lib/url';
---
<section class="py-14">
  <div class="relative overflow-hidden rounded-3xl bg-zinc-900 px-7 py-10 text-white sm:px-10 dark:bg-zinc-900 dark:ring-1 dark:ring-zinc-800">
    <div class="pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-full bg-teal-500/30 blur-3xl"></div>
    <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">Work with me</h2>
        <p class="mt-2 max-w-md text-zinc-300">Hiring, open-source collaboration, talks or community events.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={url('work-with-me/')} class="btn border-teal-500 bg-teal-500 text-white hover:bg-teal-400 hover:text-white">Work with me</a>
        <a href={url('contact/')} class="btn border-zinc-600 text-white hover:text-teal-300">Get in touch</a>
        <a href={SITE.resume} target="_blank" rel="noopener" class="btn border-zinc-600 text-white hover:text-teal-300">Resume</a>
      </div>
    </div>
  </div>
</section>
