---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Socials from '../components/Socials.astro';
import { NAV, MORE, SITE, SOCIALS } from '../data/site';
import { url } from '../lib/url';
import { ROLES } from '../data/roles';
import { graph, SAME_AS } from '../lib/seo';
interface Props { title?: string; description?: string }
const { title, description = `${SITE.name} — ${SITE.tagline}` } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — Software engineer (DevOps, Backend, AI, Web3)`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const isProfile = path === url('') || path === url('about/');
const ld = JSON.stringify(graph(canonical, fullTitle, isProfile));
const gsv = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bsv = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const isActive = (href: string) => (href === '' ? path === url('') : path.startsWith(url(href)));
const cmds = [
  ...NAV.map((n) => ({ n: n.label, u: url(n.href), g: 'page' })),
  ...MORE.map((n) => ({ n: n.label, u: url(n.href), g: 'page' })),
  ...ROLES.map((r) => ({ n: `${r.title} work`, u: url(`roles/${r.key}/`), g: 'role' })),
  ...SOCIALS.map((s) => ({ n: s.name, u: s.url, g: 'social' })),
  { n: 'Resume', u: SITE.resume, g: 'link' },
  { n: 'Book a call', u: SITE.calendar, g: 'link' },
  { n: 'Buy me a coffee', u: SITE.coffee, g: 'link' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Karun Pacholi" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <meta name="theme-color" content="#2f6b4f" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={isProfile ? 'profile' : 'website'} />
  <meta property="og:site_name" content="Karun Pacholi" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(url('assets/karun-lake.jpg'), Astro.site).href} />
  <meta property="og:image:alt" content="Karun Pacholi" />
  {isProfile && <meta property="profile:first_name" content="Karun" />}
  {isProfile && <meta property="profile:last_name" content="Pacholi" />}
  {isProfile && <meta property="profile:username" content="kpj2006" />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@_kpj2006" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(url('assets/karun-lake.jpg'), Astro.site).href} />
  {gsv && <meta name="google-site-verification" content={gsv} />}
  {bsv && <meta name="msvalidate.01" content={bsv} />}
  <link rel="icon" href={url('assets/avatar.jpg')} />
  <link rel="apple-touch-icon" href={url('assets/avatar.jpg')} />
  <link rel="sitemap" href={url('sitemap-index.xml')} />
  <link rel="alternate" type="text/plain" title="LLM-friendly summary" href={url('llms.txt')} />
  {SAME_AS.map((u) => <link rel="me" href={u} />)}
  <script type="application/ld+json" set:html={ld} />
  <script is:inline>
    try { const t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); if (t === 'dark') document.documentElement.classList.add('dark'); } catch (e) {}
  </script>
</head>
<body class="min-h-screen">
  <header class="sticky top-0 z-40 border-b border-line bg-paper/85 backdrop-blur-md dark:border-night-line dark:bg-night/85">
    <div class="mx-auto flex h-16 max-w-[68rem] items-center gap-4 px-5">
      <a href={url('')} class="mr-4 flex shrink-0 items-center gap-2.5 font-semibold text-ink dark:text-stone-50">
        <img src={url('assets/avatar.jpg')} alt="" class="h-8 w-8 rounded-full object-cover ring-2 ring-brand/30" />
        <span class="whitespace-nowrap">Karun Pacholi</span>
      </a>
      <nav id="nav" class="ml-auto hidden items-center gap-0.5 text-[15px] xl:flex">
        {NAV.map((n) => (
          <a href={url(n.href)} class={`whitespace-nowrap rounded-lg px-2.5 py-1.5 transition ${isActive(n.href) ? 'font-semibold text-ink dark:text-stone-50' : 'text-muted hover:text-ink dark:text-muted dark:hover:text-stone-100'}`}>{n.label}</a>
        ))}
        <div class="group relative">
          <button class="whitespace-nowrap rounded-lg px-2.5 py-1.5 text-muted hover:text-ink dark:text-muted dark:hover:text-stone-100">More ▾</button>
          <div class="invisible absolute right-0 top-full w-52 rounded-md border border-line bg-card p-1.5 opacity-0 shadow-xl transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 dark:border-night-line dark:bg-night-card">
            {MORE.map((n) => <a href={url(n.href)} class="block rounded-lg px-3 py-2 text-stone-700 hover:bg-paper dark:text-stone-300 dark:hover:bg-night-card">{n.label}</a>)}
            <a href={SITE.resume} target="_blank" rel="noopener" class="block rounded-lg px-3 py-2 text-stone-700 hover:bg-paper dark:text-stone-300 dark:hover:bg-night-card">Resume ↗</a>
          </div>
        </div>
      </nav>
      <div class="ml-auto flex shrink-0 items-center gap-2 xl:ml-3">
        <button id="openCmd" class="flex h-9 items-center gap-2 rounded-md border border-line px-2.5 text-muted hover:border-brand dark:border-night-line dark:text-muted" aria-label="Search">
          <Icon name="search" class="h-4 w-4" />
        </button>
        <button id="theme" class="grid h-9 w-9 place-items-center rounded-md border border-line text-muted hover:border-brand dark:border-night-line dark:text-stone-300" aria-label="Toggle theme"><Icon name="moon" /></button>
        <button id="burger" class="grid h-9 w-9 place-items-center rounded-md border border-line text-muted xl:hidden dark:border-night-line dark:text-stone-300" aria-label="Menu"><Icon name="menu" /></button>
      </div>
    </div>
    <div id="mobileNav" class="hidden border-t border-line px-5 py-3 xl:hidden dark:border-night-line">
      <div class="grid grid-cols-2 gap-1 text-[15px]">
        {[...NAV, ...MORE].map((n) => <a href={url(n.href)} class="rounded-lg px-3 py-2 text-stone-700 hover:bg-paper dark:text-stone-300 dark:hover:bg-night-card">{n.label}</a>)}
      </div>
    </div>
  </header>

  <main class="container-x"><slot /></main>

  <footer class="mt-10 border-t border-line dark:border-night-line">
    <div class="container-x flex flex-col gap-4 border-b border-line py-8 sm:flex-row sm:items-center sm:justify-between dark:border-night-line">
      <div>
        <p class="font-serif text-xl font-semibold text-ink dark:text-stone-50">Work with me</p>
        <p class="muted text-[15px]">Hiring, open-source collaboration, talks or community events.</p>
      </div>
      <a href={url('work-with-me/')} class="btn btn-primary shrink-0">Work with me <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
    <div class="container-x flex flex-col gap-5 py-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="text-sm text-muted">© {new Date().getFullYear()} Karun Pacholi · Built with Astro · <a class="hover:text-brand" href="https://github.com/kpj2006/me" target="_blank" rel="noopener">source</a> · <a class="hover:text-brand" href={url('work-with-me/')}>Work with me</a></div>
      <Socials size="sm" />
    </div>
  </footer>

  <div id="cmdk" class="fixed inset-0 z-50 hidden items-start justify-center bg-black/50 px-4 pt-[12vh] backdrop-blur-sm">
    <div class="w-full max-w-lg overflow-hidden rounded-md border border-line bg-card shadow-2xl dark:border-night-line dark:bg-night-card">
      <input id="cmdInput" placeholder="Go to a page, role or link…" autocomplete="off" class="w-full border-b border-line bg-transparent px-5 py-4 text-base outline-none dark:border-night-line" />
      <ul id="cmdList" class="max-h-[50vh] overflow-auto p-2"></ul>
    </div>
  </div>

  <script is:inline define:vars={{ cmds }}>
    const root = document.documentElement;
    document.getElementById('theme').onclick = () => { const d = root.classList.toggle('dark'); try { localStorage.setItem('theme', d ? 'dark' : 'light'); } catch (e) {} };
    document.getElementById('burger').onclick = () => document.getElementById('mobileNav').classList.toggle('hidden');
    const box = document.getElementById('cmdk'), inp = document.getElementById('cmdInput'), list = document.getElementById('cmdList');
    let sel = 0, cur = [];
    const draw = () => { const q = inp.value.toLowerCase(); cur = cmds.filter((c) => c.n.toLowerCase().includes(q) || c.g.includes(q)); sel = Math.min(sel, Math.max(cur.length - 1, 0));
      list.innerHTML = cur.map((c, i) => `<li data-i="${i}" class="flex cursor-pointer justify-between rounded-lg px-3 py-2.5 text-[15px] ${i === sel ? 'bg-brand/10 text-brand dark:bg-brand-soft/10 dark:text-brand-soft' : ''}">${c.n}<small class="font-mono text-xs text-muted">${c.g}</small></li>`).join(''); };
    const open = () => { box.classList.remove('hidden'); box.classList.add('flex'); inp.value = ''; sel = 0; draw(); inp.focus(); };
    const close = () => { box.classList.add('hidden'); box.classList.remove('flex'); };
    const go = (c) => { if (!c) return; close(); c.u.startsWith('/') ? (location.href = c.u) : window.open(c.u, '_blank', 'noopener'); };
    document.getElementById('openCmd').onclick = open;
    box.onclick = (e) => { if (e.target === box) close(); const li = e.target.closest('li'); if (li) go(cur[+li.dataset.i]); };
    inp.oninput = () => { sel = 0; draw(); };
    addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); box.classList.contains('hidden') ? open() : close(); return; }
      if (box.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowDown') { sel = Math.min(sel + 1, cur.length - 1); draw(); e.preventDefault(); }
      else if (e.key === 'ArrowUp') { sel = Math.max(sel - 1, 0); draw(); e.preventDefault(); }
      else if (e.key === 'Enter') go(cur[sel]);
    });
  </script>
</body>
</html>
