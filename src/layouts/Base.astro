---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Socials from '../components/Socials.astro';
import { NAV, MORE, SITE, SOCIALS } from '../data/site';
import { url } from '../lib/url';
import { ROLES } from '../data/roles';
interface Props { title?: string; description?: string }
const { title, description = `${SITE.name} — ${SITE.tagline}` } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — Software engineer (DevOps, Backend, AI, Web3)`;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '' ? path === url('') : path.startsWith(url(href)));
const cmds = [
  ...NAV.map((n) => ({ n: n.label, u: url(n.href), g: 'page' })),
  ...MORE.map((n) => ({ n: n.label, u: url(n.href), g: 'page' })),
  ...ROLES.map((r) => ({ n: `${r.title} work`, u: url(`roles/${r.key}/`), g: 'role' })),
  ...SOCIALS.map((s) => ({ n: s.name, u: s.url, g: 'social' })),
  { n: 'Resume', u: SITE.resume, g: 'link' },
  { n: 'Book a call', u: SITE.calendar, g: 'link' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(url('assets/karun-lake.jpg'), Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={url('assets/avatar.jpg')} />
  <link rel="canonical" href={new URL(path, Astro.site).href} />
  <script is:inline>
    try { const t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); if (t === 'dark') document.documentElement.classList.add('dark'); } catch (e) {}
  </script>
</head>
<body class="min-h-screen">
  <header class="sticky top-0 z-40 border-b border-zinc-200/70 bg-white/80 backdrop-blur-md dark:border-zinc-800/70 dark:bg-zinc-950/80">
    <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-5">
      <a href={url('')} class="flex items-center gap-2.5 font-semibold text-zinc-900 dark:text-zinc-50">
        <img src={url('assets/avatar.jpg')} alt="" class="h-8 w-8 rounded-full object-cover ring-2 ring-teal-500/30" />
        <span class="whitespace-nowrap">Karun Pacholi</span>
      </a>
      <nav id="nav" class="ml-auto hidden items-center gap-1 text-[14.5px] lg:flex">
        {NAV.map((n) => (
          <a href={url(n.href)} class={`whitespace-nowrap rounded-lg px-2.5 py-1.5 transition ${isActive(n.href) ? 'font-semibold text-zinc-900 dark:text-zinc-50' : 'text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100'}`}>{n.label}</a>
        ))}
        <div class="group relative">
          <button class="rounded-lg px-2.5 py-1.5 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">More ▾</button>
          <div class="invisible absolute right-0 top-full w-52 rounded-xl border border-zinc-200 bg-white p-1.5 opacity-0 shadow-xl transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 dark:border-zinc-800 dark:bg-zinc-900">
            {MORE.map((n) => <a href={url(n.href)} class="block rounded-lg px-3 py-2 text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800">{n.label}</a>)}
            <a href={SITE.resume} target="_blank" rel="noopener" class="block rounded-lg px-3 py-2 text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800">Resume ↗</a>
          </div>
        </div>
      </nav>
      <div class="ml-auto flex items-center gap-2 lg:ml-2">
        <button id="openCmd" class="flex h-9 items-center gap-2 rounded-xl border border-zinc-200 px-2.5 text-zinc-500 hover:border-teal-500 dark:border-zinc-800 dark:text-zinc-400" aria-label="Search">
          <Icon name="search" class="h-4 w-4" /><kbd class="hidden font-mono text-[11px] xl:inline">Ctrl K</kbd>
        </button>
        <button id="theme" class="grid h-9 w-9 place-items-center rounded-xl border border-zinc-200 text-zinc-600 hover:border-teal-500 dark:border-zinc-800 dark:text-zinc-300" aria-label="Toggle theme"><Icon name="moon" /></button>
        <button id="burger" class="grid h-9 w-9 place-items-center rounded-xl border border-zinc-200 text-zinc-600 lg:hidden dark:border-zinc-800 dark:text-zinc-300" aria-label="Menu"><Icon name="menu" /></button>
      </div>
    </div>
    <div id="mobileNav" class="hidden border-t border-zinc-200 px-5 py-3 lg:hidden dark:border-zinc-800">
      <div class="grid grid-cols-2 gap-1 text-[15px]">
        {[...NAV, ...MORE].map((n) => <a href={url(n.href)} class="rounded-lg px-3 py-2 text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800">{n.label}</a>)}
      </div>
    </div>
  </header>

  <main class="container-x"><slot /></main>

  <footer class="mt-10 border-t border-zinc-200 dark:border-zinc-800">
    <div class="container-x flex flex-col gap-5 py-8 sm:flex-row sm:items-center sm:justify-between">
      <div class="text-sm text-zinc-500">© {new Date().getFullYear()} Karun Pacholi · Built with Astro · <a class="hover:text-teal-600" href="https://github.com/kpj2006/me" target="_blank" rel="noopener">source</a></div>
      <Socials size="sm" />
    </div>
  </footer>

  <div id="cmdk" class="fixed inset-0 z-50 hidden items-start justify-center bg-black/50 px-4 pt-[12vh] backdrop-blur-sm">
    <div class="w-full max-w-lg overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-2xl dark:border-zinc-800 dark:bg-zinc-900">
      <input id="cmdInput" placeholder="Go to a page, role or link…" autocomplete="off" class="w-full border-b border-zinc-200 bg-transparent px-5 py-4 text-base outline-none dark:border-zinc-800" />
      <ul id="cmdList" class="max-h-[50vh] overflow-auto p-2"></ul>
    </div>
  </div>

  <script is:inline define:vars={{ cmds }}>
    const root = document.documentElement;
    document.getElementById('theme').onclick = () => { const d = root.classList.toggle('dark'); try { localStorage.setItem('theme', d ? 'dark' : 'light'); } catch (e) {} };
    document.getElementById('burger').onclick = () => document.getElementById('mobileNav').classList.toggle('hidden');
    const box = document.getElementById('cmdk'), inp = document.getElementById('cmdInput'), list = document.getElementById('cmdList');
    let sel = 0, cur = [];
    const draw = () => { const q = inp.value.toLowerCase(); cur = cmds.filter((c) => c.n.toLowerCase().includes(q) || c.g.includes(q)); sel = Math.min(sel, Math.max(cur.length - 1, 0));
      list.innerHTML = cur.map((c, i) => `<li data-i="${i}" class="flex cursor-pointer justify-between rounded-lg px-3 py-2.5 text-[15px] ${i === sel ? 'bg-teal-50 text-teal-800 dark:bg-teal-400/10 dark:text-teal-300' : ''}">${c.n}<small class="font-mono text-xs text-zinc-400">${c.g}</small></li>`).join(''); };
    const open = () => { box.classList.remove('hidden'); box.classList.add('flex'); inp.value = ''; sel = 0; draw(); inp.focus(); };
    const close = () => { box.classList.add('hidden'); box.classList.remove('flex'); };
    const go = (c) => { if (!c) return; close(); c.u.startsWith('/') ? (location.href = c.u) : window.open(c.u, '_blank', 'noopener'); };
    document.getElementById('openCmd').onclick = open;
    box.onclick = (e) => { if (e.target === box) close(); const li = e.target.closest('li'); if (li) go(cur[+li.dataset.i]); };
    inp.oninput = () => { sel = 0; draw(); };
    addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); box.classList.contains('hidden') ? open() : close(); return; }
      if (box.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowDown') { sel = Math.min(sel + 1, cur.length - 1); draw(); e.preventDefault(); }
      else if (e.key === 'ArrowUp') { sel = Math.max(sel - 1, 0); draw(); e.preventDefault(); }
      else if (e.key === 'Enter') go(cur[sel]);
    });
  </script>
</body>
</html>
