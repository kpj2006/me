---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { ROLES, COMMUNITY } from '../../data/roles';
import { PROJECTS } from '../../data/projects';
import { url } from '../../lib/url';
export function getStaticPaths() { return ROLES.map((r) => ({ params: { slug: r.key }, props: { role: r } })); }
const { role } = Astro.props;
const all = [...PROJECTS, ...COMMUNITY];
const items = role.items.map((s) => all.find((p) => p.slug === s)!);
const projects = items.filter((p) => p.kind !== 'contribution');
const contribs = items.filter((p) => p.kind === 'contribution');
---
<Base title={`${role.title} work`} description={`Karun Pacholi — ${role.title} work and projects. ${role.pitch}`}>
  <PageHeader eyebrow={`${role.icon} Role`} title={role.title} text={role.pitch}>
    <div class="mt-6 flex flex-wrap gap-2">
      {ROLES.map((r) => (
        <a href={url(`roles/${r.key}/`)} class={`rounded-full border px-3 py-1 text-[13px] font-semibold transition ${r.key === role.key ? 'border-ink bg-ink text-white dark:border-line dark:bg-paper dark:text-ink' : 'border-line text-muted hover:border-brand dark:border-night-line dark:text-muted'}`}>{r.title}</a>
      ))}
    </div>
  </PageHeader>
  <section class="pb-10">
    <h2 class="mb-5 text-sm font-semibold uppercase tracking-wider text-muted">{role.key === 'devrel' ? 'Community & volunteering' : 'Projects'} · {projects.length}</h2>
    <div class="grid gap-4 md:grid-cols-2">{projects.map((p) => <ProjectCard p={p} />)}</div>
  </section>
  {contribs.length > 0 && (
    <section class="pb-6">
      <h2 class="mb-5 text-sm font-semibold uppercase tracking-wider text-muted">Merged in other projects · {contribs.length}</h2>
      <div class="grid gap-4 md:grid-cols-2">{contribs.map((p) => <ProjectCard p={p} />)}</div>
    </section>
  )}
</Base>
