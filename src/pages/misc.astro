---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/url';
const items = [
  ['Work with me', 'work-with-me/', 'How I can help your team, and how to reach me.'],
  ['Appearances', 'appearances/', 'Programs, hackathons and events I took part in.'],
  ['Sponsorship', 'sponsorship/', 'Support my open-source work on CI/CD and contributor tooling.'],
  ['Uses', 'uses/', 'Hardware, software and tools I use daily. Updated occasionally.'],
  ['Stats', 'stats/', 'My open-source numbers, rebuilt every week by CI.'],
  ["People I've met", 'people/', 'Mentors and builders who helped me.'],
  ['Certificates', 'certificates/', 'Programs I was selected for.'],
  ['Build Log', 'newsletter/', 'A short monthly note on what I shipped.'],
];
---
<Base title="Misc" description="Other pages by Karun Pacholi.">
  <PageHeader title="Misc" text="Everything that isn't a project or a talk." />
  <div class="divide-y divide-zinc-200 dark:divide-zinc-800">
    {items.map(([t, h, d]) => <a href={url(h)} class="group block py-5"><h3 class="text-lg font-semibold text-zinc-900 group-hover:text-teal-600 dark:text-zinc-50">{t}</h3><p class="text-zinc-500">{d}</p></a>)}
  </div>
</Base>
