---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Recognition from '../components/Recognition.astro';
import Icon from '../components/Icon.astro';
import { HELP } from '../data/content';
import { SITE, SOCIALS } from '../data/site';
const field = 'w-full rounded-md border border-line bg-card px-3.5 py-2.5 text-[15px] outline-none focus:border-brand focus:ring-2 focus:ring-brand/20 dark:border-night-line dark:bg-night';
---
<Base title="Work with me" description="Hire or collaborate with Karun Pacholi.">
  <PageHeader title="Work with me" text="Open to internships and full-time roles, plus open-source collaboration, talks and community events.">
    <div class="mt-6 flex flex-wrap gap-2">
      <a class="btn btn-primary" href="#contact">Get in touch</a>
      <a class="btn" href={SITE.resume} target="_blank" rel="noopener">Resume</a>
      <a class="btn" href={SITE.calendar} target="_blank" rel="noopener">Book a call</a>
    </div>
  </PageHeader>
  <section class="pb-12">
    <SectionHead title="How I can help" />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {HELP.map((h) => <div class="card card-hover"><div class="text-2xl">{h.icon}</div><h3 class="mt-2 font-semibold text-ink dark:text-stone-50">{h.title}</h3><p class="mt-1 text-[14.5px] text-muted dark:text-muted">{h.text}</p></div>)}
    </div>
  </section>
  <section class="pb-12">
    <SectionHead title="Recognition" />
    <Recognition />
  </section>
  <section id="contact" class="band scroll-mt-20 py-14">
    <SectionHead title="Get in touch" />
    <p class="muted -mt-3 mb-5">Tell me what you're building. The form opens your email app with the message filled in.</p>
    <form id="cform" class="card grid gap-4 sm:grid-cols-2">
      <label class="text-sm font-semibold">Name *<input name="name" required class={`mt-1.5 ${field}`} /></label>
      <label class="text-sm font-semibold">Email *<input name="email" type="email" required class={`mt-1.5 ${field}`} /></label>
      <label class="text-sm font-semibold">Company / website<input name="site" class={`mt-1.5 ${field}`} /></label>
      <label class="text-sm font-semibold">Topic<select name="topic" class={`mt-1.5 ${field}`}><option>Job / internship</option><option>Maintain my open-source project</option><option>Open-source collaboration</option><option>Talk or workshop</option><option>Community event</option><option>Other</option></select></label>
      <label class="text-sm font-semibold sm:col-span-2">Message *<textarea name="msg" rows="5" required class={`mt-1.5 ${field}`}></textarea></label>
      <div class="sm:col-span-2"><button class="btn btn-primary" type="submit">Send message</button></div>
    </form>
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {SOCIALS.map((s) => (
        <a href={s.url} target={s.url.startsWith('mailto') ? undefined : '_blank'} rel="noopener" class="card card-hover flex items-center gap-3 p-4">
          <Icon name={s.icon} class="h-5 w-5 shrink-0 text-brand dark:text-brand-soft" />
          <span class="min-w-0"><b class="block text-sm">{s.name}</b><span class="block truncate text-xs text-muted">{s.handle}</span></span>
        </a>
      ))}
      <a href={SITE.calendar} target="_blank" rel="noopener" class="card card-hover flex items-center gap-3 p-4"><span class="text-lg">📅</span><span><b class="block text-sm">Calendar</b><span class="text-xs text-muted">Book a call</span></span></a>
    </div>
  </section>
  <script is:inline define:vars={{ email: SITE.email }}>
    document.getElementById('cform').onsubmit = (e) => {
      e.preventDefault(); const f = new FormData(e.target);
      const body = `${f.get('msg')}\n\n— ${f.get('name')} (${f.get('email')})${f.get('site') ? '\n' + f.get('site') : ''}`;
      location.href = `mailto:${email}?subject=${encodeURIComponent('[' + f.get('topic') + '] from ' + f.get('name'))}&body=${encodeURIComponent(body)}`;
    };
  </script>
</Base>
