---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import { EVENTS, VIDEOS } from '../data/content';
const va = VIDEOS.filter((v) => v.tag === 'Session');
---
<Base title="Appearances" description="Programs, hackathons and events Karun Pacholi took part in.">
  <PageHeader title="Appearances" text="Programs, hackathons and events I took part in." />
  <section class="pb-12">
    <SectionHead title="Events & programs" />
    <div class="space-y-3">
      {EVENTS.map((e) => (
        <article class="card grid gap-2 sm:grid-cols-[7rem_1fr]">
          <span class="font-mono text-xs text-muted">{e.date}</span>
          <div><span class="eyebrow">{e.role}</span><h3 class="mt-1 font-semibold text-ink dark:text-stone-50">{e.title}</h3><p class="text-[14.5px] text-muted dark:text-muted">{e.text}</p>{e.url && <a class="link text-sm" href={e.url} target="_blank" rel="noopener">Link ↗</a>}</div>
        </article>
      ))}
    </div>
  </section>
  <section>
    <SectionHead title="Video appearances" />
    <div class="grid gap-5 sm:grid-cols-3">
      {va.map((v) => (
        <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener" class="card card-hover overflow-hidden p-0">
          <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" class="aspect-video w-full object-cover" />
          <div class="p-4"><h3 class="font-semibold">{v.title}</h3><p class="text-sm text-muted">{v.date}</p></div>
        </a>
      ))}
    </div>
  </section>
</Base>
