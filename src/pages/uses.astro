---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { USES } from '../data/content';
import { url } from '../lib/url';
---
<Base title="Uses" description="Tools Karun Pacholi uses daily.">
  <PageHeader title="Uses" text="Hardware, software and tools I use daily. Updated now and then." />
  <figure class="card mb-6 overflow-hidden p-2"><img src={url('assets/setup.jpg')} alt="Karun's desk: HP OMEN laptop, Dell 24 Plus monitor, Rapoo keyboard and HP mouse" class="w-full rounded-sm" loading="lazy" /><figcaption class="muted px-2 pt-2 text-sm">My desk in Jaipur.</figcaption></figure>
  <div class="grid gap-4 sm:grid-cols-2">
    {USES.map((u) => (
      <div class="card"><h3 class="font-semibold text-ink dark:text-stone-50">{u.title}</h3><ul class="mt-2 list-disc space-y-1 pl-5 text-[14.5px] text-muted dark:text-muted">{u.items.map((x) => <li set:html={x} />)}</ul></div>
    ))}
  </div>
</Base>
