---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { CERTS } from '../data/content';
import { SITE } from '../data/site';
---
<Base title="Certificates" description="Programs and certificates of Karun Pacholi.">
  <PageHeader title="Certificates" text={`Programs I was selected for and certificates I earned. <a class="link" href="${SITE.linkedin}" target="_blank" rel="noopener">Proof on LinkedIn ↗</a>`} />
  <div class="grid gap-4 sm:grid-cols-2">
    {CERTS.map((c) => (
      <div class="card flex gap-4">
        <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-zinc-100 text-2xl dark:bg-zinc-800">{c.icon}</div>
        <div>{c.year && <span class="font-mono text-xs font-semibold text-teal-700 dark:text-teal-300">{c.year}</span>}<b class="block text-zinc-900 dark:text-zinc-50">{c.title}</b><span class="text-sm text-zinc-500">{c.sub}</span></div>
      </div>
    ))}
  </div>
</Base>
