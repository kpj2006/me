---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Recognition from '../components/Recognition.astro';
import BrandIcon from '../components/BrandIcon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';
import { SITE, EXPERIENCE, SOCIALS } from '../data/site';
import { ROLES, COMMUNITY } from '../data/roles';
import { PROJECTS } from '../data/projects';
import { PRS, REPOS, ORGS } from '../lib/prs';
import { DESIGNS } from '../data/content';
import { url } from '../lib/url';

const all = [...PROJECTS, ...COMMUNITY];
const get = (s: string) => all.find((p) => p.slug === s)!;
const featured = ['gitpay', 'no-dues-portal', 'skillbot'].map(get);
---
<Base>
  <!-- Hero -->
  <section class="band grid items-center gap-10 pb-14 pt-14 sm:pt-20 md:grid-cols-[1.35fr_1fr]">
    <div>
      <h1 class="font-serif text-[3.4rem] font-semibold leading-[1.05] tracking-tight text-ink sm:text-[4.2rem] dark:text-stone-50">Karun Pacholi</h1>
      <p class="mt-3 text-[1.45rem] font-medium text-brand dark:text-brand-soft">GSoC'26 DevOps Lead · AOSSIE</p>
      <p class="mt-5 max-w-[34rem] text-[1.12rem] leading-relaxed text-stone-700 dark:text-stone-300">{SITE.tagline} {SITE.intro}</p>
      <div class="mt-5 flex items-center gap-4 text-muted dark:text-night-muted">
        {SOCIALS.map((s) => (
          <a href={s.url} target={s.url.startsWith('mailto') ? undefined : '_blank'} rel="noopener" aria-label={s.name} class="transition hover:text-brand dark:hover:text-brand-soft"><Icon name={s.icon} class="h-[18px] w-[18px]" /></a>
        ))}
      </div>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={url('work-with-me/')} class="btn btn-primary">Work with me <Icon name="arrow" class="h-4 w-4" /></a>
        <a href={SITE.resume} target="_blank" rel="noopener" class="btn">Resume</a>
      </div>
      <p class="mt-5 text-[13px] text-muted dark:text-night-muted"><kbd class="rounded border border-line px-1.5 py-0.5 font-mono text-[11px] dark:border-night-line">Ctrl K</kbd> opens the command center</p>
    </div>
    <div class="relative mx-auto w-full max-w-sm md:max-w-none">
      <div class="overflow-hidden rounded-md border border-line bg-card p-2 dark:border-night-line dark:bg-night-card">
        <img src={url('assets/karun-lake.jpg')} alt="Karun Pacholi" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_30%]" />
      </div>
      <div class="absolute bottom-5 left-5 flex items-center gap-2 rounded-lg bg-card/95 px-3 py-1.5 text-[13px] font-medium shadow dark:bg-night-card/95">
        <span class="h-2 w-2 rounded-full bg-emerald-500 ring-4 ring-emerald-500/20"></span>Open to work · anywhere
      </div>
    </div>
  </section>

  <!-- Recognition -->
  <section class="pb-4 pt-12"><Recognition /></section>

  <!-- Stats -->
  <section class="mt-3 grid grid-cols-3 gap-3">
    <a href={url('open-source/')} class="card card-hover py-4 text-center"><div class="font-serif text-3xl font-semibold">{PRS.length}</div><div class="muted text-[13px]">merged PRs</div></a>
    <a href={url('open-source/')} class="card card-hover py-4 text-center"><div class="font-serif text-3xl font-semibold">{REPOS.size}</div><div class="muted text-[13px]">repositories</div></a>
    <a href={url('expertise/')} class="card card-hover py-4 text-center"><div class="font-serif text-3xl font-semibold">{PROJECTS.filter((p) => p.kind !== 'contribution').length}+</div><div class="muted text-[13px]">projects</div></a>
  </section>

  <!-- Roles -->
  <section id="roles" class="band mt-14 scroll-mt-20 py-16">
    <SectionHead title="What I've done, by role" />
    <p class="muted -mt-3 mb-5">Pick a role to see the work behind it.</p>
    <div class="mb-5 flex flex-wrap gap-2" role="tablist">
      {ROLES.map((r, i) => (
        <button data-role={r.key} role="tab" aria-selected={i === 0 ? 'true' : 'false'}
          class="role-tab rounded-full border border-line px-3.5 py-1.5 text-sm font-semibold text-muted transition hover:border-brand hover:text-ink aria-selected:border-ink aria-selected:bg-ink aria-selected:text-white dark:border-night-line dark:text-muted dark:aria-selected:border-line dark:aria-selected:bg-paper dark:aria-selected:text-ink">
          <span class="mr-1">{r.icon}</span>{r.title}
        </button>
      ))}
      <button data-role="design" role="tab" aria-selected="false"
        class="role-tab rounded-full border border-line px-3.5 py-1.5 text-sm font-semibold text-muted transition hover:border-brand hover:text-ink aria-selected:border-ink aria-selected:bg-ink aria-selected:text-white dark:border-night-line dark:text-muted dark:aria-selected:border-line dark:aria-selected:bg-paper dark:aria-selected:text-ink">
        <span class="mr-1">🎨</span>Graphic Design
      </button>
    </div>
    {ROLES.map((r, i) => (
      <div id={`role-${r.key}`} class="role-panel" hidden={i !== 0}>
        <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <p class="text-lg font-medium text-ink dark:text-stone-200">{r.pitch}</p>
          <a href={url(`roles/${r.key}/`)} class="link shrink-0 text-sm">All {r.items.length} {r.title} blocks →</a>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {r.items.slice(0, 3).map((s) => <ProjectCard p={get(s)} compact />)}
        </div>
      </div>
    ))}
    <div id="role-design" class="role-panel" hidden>
      <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <p class="text-lg font-medium text-ink dark:text-stone-200">Posters, banners and merch for college clubs and events, made in Figma.</p>
        <a href={url('expertise/#design')} class="link shrink-0 text-sm">All {DESIGNS.length} designs →</a>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {DESIGNS.slice(0, 3).map((x) => (
          <a href={url('expertise/#design')} class="card card-hover overflow-hidden p-2">
            <div class="aspect-[4/5] overflow-hidden rounded-sm bg-paper dark:bg-night"><img src={url(`assets/design/${x.img}.jpg`)} alt={x.title} loading="lazy" class="h-full w-full object-cover object-top" /></div>
            <div class="px-2 pb-1 pt-3"><b class="block font-serif text-lg text-ink dark:text-stone-50">{x.title}</b><span class="muted text-[13px]">{x.sub}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="py-16">
    <SectionHead title="Experience" href={url('about/')} linkText="Full journey" />
    <ol class="relative ml-2 border-l-2 border-line dark:border-night-line">
      {EXPERIENCE.map((e, i) => (
        <li class="relative mb-8 pl-7 last:mb-0">
          <span class={`absolute -left-[9px] top-1.5 h-4 w-4 rounded-full border-[3px] bg-card dark:bg-night ${i === 0 ? 'border-brand' : 'border-line dark:border-night-line'}`}></span>
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-[17px] font-semibold text-ink dark:text-stone-50">{e.role}</h3>
            <span class="font-mono text-xs text-muted">{e.when}</span>
          </div>
          <div class="text-[14.5px] font-medium text-brand dark:text-brand-soft">{e.org}</div>
          <p class="mt-1.5 text-[14.5px] text-muted dark:text-muted">{e.points[0]}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Featured -->
  <section class="band py-16">
    <SectionHead title="Featured work" href={url('expertise/')} linkText="All expertise" />
    <div class="grid gap-4 md:grid-cols-3">{featured.map((p) => <ProjectCard p={p} compact />)}</div>
  </section>

  <script is:inline>
    (() => {
      const tabs = [...document.querySelectorAll('.role-tab')], panels = [...document.querySelectorAll('.role-panel')];
      const show = (k, scroll) => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.role === k)));
        panels.forEach((p) => (p.hidden = p.id !== 'role-' + k));
        if (scroll) document.getElementById('roles').scrollIntoView({ behavior: 'smooth' });
      };
      tabs.forEach((t) => (t.onclick = () => { show(t.dataset.role); history.replaceState(null, '', '#role-' + t.dataset.role); }));
      const h = location.hash.replace('#role-', '');
      if (h && document.getElementById('role-' + h)) show(h, true);
    })();
  </script>
</Base>
