---
import Base from '../layouts/Base.astro';
import Socials from '../components/Socials.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkWithMe from '../components/WorkWithMe.astro';
import { SITE, FACTS, EXPERIENCE } from '../data/site';
import { ROLES, COMMUNITY } from '../data/roles';
import { PROJECTS } from '../data/projects';
import { SKILLS } from '../data/content';
import { PRS, REPOS, ORGS } from '../lib/prs';
import { url } from '../lib/url';

const all = [...PROJECTS, ...COMMUNITY];
const get = (s: string) => all.find((p) => p.slug === s)!;
const featured = ['gitpay', 'no-dues-portal', 'skillbot'].map(get);
---
<Base>
  <!-- Hero -->
  <section class="grid items-center gap-10 pb-8 pt-14 sm:pt-20 md:grid-cols-[1.3fr_1fr]">
    <div>
      <p class="eyebrow mb-4">Namaste 🙏 I'm</p>
      <h1 class="text-5xl font-extrabold tracking-tight text-zinc-900 sm:text-6xl dark:text-zinc-50">Karun Pacholi</h1>
      <p class="mt-5 text-xl font-semibold text-zinc-900 dark:text-zinc-100">{SITE.tagline}</p>
      <p class="mt-3 max-w-xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">{SITE.intro}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={SITE.resume} target="_blank" rel="noopener" class="btn btn-primary">View resume</a>
        <a href={url('work-with-me/')} class="btn">Work with me</a>
        <a href={SITE.calendar} target="_blank" rel="noopener" class="btn">Book a call</a>
      </div>
      <div class="mt-6"><Socials /></div>
    </div>
    <div class="relative mx-auto w-full max-w-sm md:max-w-none">
      <div class="absolute -inset-3 -z-10 rounded-[2rem] bg-gradient-to-br from-teal-200/60 via-transparent to-amber-200/50 blur-2xl dark:from-teal-500/20 dark:to-amber-500/10"></div>
      <img src={url('assets/karun-lake.jpg')} alt="Karun Pacholi" class="aspect-[4/5] w-full rounded-3xl object-cover object-[50%_30%] shadow-xl ring-1 ring-zinc-900/5" />
      <div class="absolute bottom-4 left-4 flex items-center gap-2 rounded-xl bg-white/90 px-3 py-1.5 text-[13px] font-medium shadow backdrop-blur dark:bg-zinc-900/90">
        <span class="h-2 w-2 rounded-full bg-emerald-500 ring-4 ring-emerald-500/20"></span>{SITE.location} · open to work
      </div>
    </div>
  </section>

  <!-- Facts -->
  <section class="grid grid-cols-2 gap-3 sm:grid-cols-5">
    {FACTS.map((f) => (
      <div class="card p-4"><div class="text-[15px] font-semibold text-zinc-900 dark:text-zinc-50">{f.title}</div><div class="mt-0.5 text-[13px] text-zinc-500">{f.sub}</div></div>
    ))}
    <a href={url('open-source/')} class="card card-hover p-4"><div class="text-[15px] font-semibold text-zinc-900 dark:text-zinc-50">{PRS.length} merged PRs</div><div class="mt-0.5 text-[13px] text-zinc-500">{REPOS.size} repos · {ORGS.size} orgs</div></a>
  </section>

  <!-- Roles -->
  <section id="roles" class="scroll-mt-20 py-16">
    <SectionHead title="What I've done, by role" />
    <div class="mb-5 flex flex-wrap gap-2" role="tablist">
      {ROLES.map((r, i) => (
        <button data-role={r.key} role="tab" aria-selected={i === 0 ? 'true' : 'false'}
          class="role-tab rounded-full border border-zinc-200 px-3.5 py-1.5 text-sm font-semibold text-zinc-600 transition hover:border-teal-500 hover:text-zinc-900 aria-selected:border-zinc-900 aria-selected:bg-zinc-900 aria-selected:text-white dark:border-zinc-800 dark:text-zinc-400 dark:aria-selected:border-zinc-100 dark:aria-selected:bg-zinc-100 dark:aria-selected:text-zinc-900">
          <span class="mr-1">{r.icon}</span>{r.title}
        </button>
      ))}
    </div>
    {ROLES.map((r, i) => (
      <div id={`role-${r.key}`} class="role-panel" hidden={i !== 0}>
        <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <p class="text-lg font-medium text-zinc-800 dark:text-zinc-200">{r.pitch}</p>
          <a href={url(`roles/${r.key}/`)} class="link shrink-0 text-sm">All {r.items.length} {r.title} blocks →</a>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {r.items.slice(0, 3).map((s) => <ProjectCard p={get(s)} compact />)}
        </div>
      </div>
    ))}
  </section>

  <!-- Experience -->
  <section class="pb-16">
    <SectionHead title="Experience" href={url('about/')} linkText="Full journey" />
    <ol class="relative ml-2 border-l-2 border-zinc-200 dark:border-zinc-800">
      {EXPERIENCE.map((e, i) => (
        <li class="relative mb-8 pl-7 last:mb-0">
          <span class={`absolute -left-[9px] top-1.5 h-4 w-4 rounded-full border-[3px] bg-white dark:bg-zinc-950 ${i === 0 ? 'border-teal-500' : 'border-zinc-300 dark:border-zinc-600'}`}></span>
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-[17px] font-semibold text-zinc-900 dark:text-zinc-50">{e.role}</h3>
            <span class="font-mono text-xs text-zinc-500">{e.when}</span>
          </div>
          <div class="text-[14.5px] font-medium text-teal-700 dark:text-teal-300">{e.org}</div>
          <p class="mt-1.5 text-[14.5px] text-zinc-600 dark:text-zinc-400">{e.points[0]}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Featured -->
  <section class="pb-16">
    <SectionHead title="Featured work" href={url('projects/')} linkText="All projects" />
    <div class="grid gap-4 md:grid-cols-3">{featured.map((p) => <ProjectCard p={p} compact />)}</div>
  </section>

  <!-- Skills -->
  <section class="pb-6">
    <SectionHead title="Skills" />
    <div class="flex flex-wrap gap-2">{SKILLS.map((s) => <span class="rounded-lg border border-zinc-200 px-3 py-1.5 font-mono text-[13px] dark:border-zinc-800">{s}</span>)}</div>
  </section>

  <WorkWithMe />

  <script is:inline>
    (() => {
      const tabs = [...document.querySelectorAll('.role-tab')], panels = [...document.querySelectorAll('.role-panel')];
      const show = (k, scroll) => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.role === k)));
        panels.forEach((p) => (p.hidden = p.id !== 'role-' + k));
        if (scroll) document.getElementById('roles').scrollIntoView({ behavior: 'smooth' });
      };
      tabs.forEach((t) => (t.onclick = () => { show(t.dataset.role); history.replaceState(null, '', '#role-' + t.dataset.role); }));
      const h = location.hash.replace('#role-', '');
      if (h && document.getElementById('role-' + h)) show(h, true);
    })();
  </script>
</Base>
